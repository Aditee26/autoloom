# ---------------------------------------------------------------------------
# AutoLoom configuration. Copy to `.env` (Docker Compose reads it from the
# repo root) and, for local non-Docker development, also to `server/.env`.
# NEVER commit real values.
# ---------------------------------------------------------------------------

# Required. Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Used to encrypt stored integration secrets (AES-256-GCM). Must be >= 32 characters.
# Changing it makes previously stored integration secrets undecryptable.
ENCRYPTION_KEY=change-me-to-another-long-random-string-32+

JWT_EXPIRES_IN=7d

# --- Server -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Local (non-Docker) MongoDB. Docker Compose overrides this to the compose service.
MONGO_URI=mongodb://127.0.0.1:27017/autoloom
# Separate database used only by the automated tests (the test suite refuses any URI without "test" in it).
MONGO_URI_TEST=mongodb://127.0.0.1:27017/autoloom_test

# Comma-separated browser origins allowed by CORS.
CLIENT_URL=http://localhost:5173
# Public base URL used to display webhook URLs. Docker Compose/nginx: http://localhost:8080 (or your domain).
PUBLIC_API_URL=http://localhost:5000
# Set to false to disable node-cron registration (e.g. on a secondary instance).
SCHEDULER_ENABLED=true

# --- Docker Compose ---------------------------------------------------------
# Host port for the web UI + API gateway (nginx).
WEB_PORT=8080
