        {
          "name": "Create workflow (webhook \u2192 condition \u2192 branches)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/workflows",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "workflows"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman registration flow\",\n  \"nodes\": [\n    {\n      \"id\": \"trigger_1\",\n      \"type\": \"webhookTrigger\",\n      \"position\": {\n        \"x\": 0,\n        \"y\": 0\n      },\n      \"data\": {\n        \"label\": \"Webhook\",\n        \"config\": {}\n      }\n    },\n    {\n      \"id\": \"condition_1\",\n      \"type\": \"condition\",\n      \"position\": {\n        \"x\": 250,\n        \"y\": 0\n      },\n      \"data\": {\n        \"label\": \"Company email?\",\n        \"config\": {\n          \"field\": \"{{trigger.body.email}}\",\n          \"operator\": \"contains\",\n          \"value\": \"@acme.com\"\n        }\n      }\n    },\n    {\n      \"id\": \"variable_1\",\n      \"type\": \"setVariable\",\n      \"position\": {\n        \"x\": 500,\n        \"y\": -80\n      },\n      \"data\": {\n        \"label\": \"Internal\",\n        \"config\": {\n          \"name\": \"route\",\n          \"value\": \"internal\",\n          \"valueType\": \"string\"\n        }\n      }\n    },\n    {\n      \"id\": \"variable_2\",\n      \"type\": \"setVariable\",\n      \"position\": {\n        \"x\": 500,\n        \"y\": 80\n      },\n      \"data\": {\n        \"label\": \"External\",\n        \"config\": {\n          \"name\": \"route\",\n          \"value\": \"external\",\n          \"valueType\": \"string\"\n        }\n      }\n    },\n    {\n      \"id\": \"log_1\",\n      \"type\": \"logMessage\",\n      \"position\": {\n        \"x\": 750,\n        \"y\": 0\n      },\n      \"data\": {\n        \"label\": \"Done\",\n        \"config\": {\n          \"level\": \"info\",\n          \"message\": \"{{trigger.body.email}} -> {{variables.route}}\"\n        }\n      }\n    }\n  ],\n  \"edges\": [\n    {\n      \"id\": \"e1\",\n      \"source\": \"trigger_1\",\n      \"target\": \"condition_1\"\n    },\n    {\n      \"id\": \"e2\",\n      \"source\": \"condition_1\",\n      \"target\": \"variable_1\",\n      \"sourceHandle\": \"true\"\n    },\n    {\n      \"id\": \"e3\",\n      \"source\": \"condition_1\",\n      \"target\": \"variable_2\",\n      \"sourceHandle\": \"false\"\n    },\n    {\n      \"id\": \"e4\",\n      \"source\": \"variable_1\",\n      \"target\": \"log_1\"\n    },\n    {\n      \"id\": \"e5\",\n      \"source\": \"variable_2\",\n      \"target\": \"log_1\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status ok', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('workflowId', j.data.id);",
                  "pm.collectionVariables.set('webhookUrl', j.data.webhookUrl);"
                ]
              }
            }
          ]
        },
